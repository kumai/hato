<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8"/>

    <module name="TreeWalker">
        <module name="PackageDeclaration"/>
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="CustomImportOrder">
            <property name="customImportOrderRules"
                      value="STANDARD_JAVA_PACKAGE, THIRD_PARTY_PACKAGE, SPECIAL_IMPORTS, STATIC"/>
            <property name="specialImportsRegExp" value="^org\.mqtt4j\.hato\."/>
            <property name="sortImportsInGroupAlphabetically" value="true"/>
            <property name="separateLineBetweenGroups" value="true"/>
        </module>
        <module name="OuterTypeFilename"/>
        <module name="OneTopLevelClass"/>
        <module name="ArrayTypeStyle"/>
        <module name="UpperEll"/>

        <module name="NeedBraces"/>
        <module name="ModifierOrder"/>
        <module name="UnusedLocalVariable"/>
        <module name="UnusedCatchParameterShouldBeUnnamed"/>
        <module name="UseEnhancedSwitch"/>

        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
    </module>

    <module name="NewlineAtEndOfFile"/>

    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <module name="RegexpSingleline">
        <property name="format" value="[ \t]+$"/>
        <property name="message" value="Line has trailing whitespace."/>
    </module>

    <!-- Markdown doc comments render a block tag description that starts on the next line as
         code when it is indented four or more spaces past the comment's common indentation,
         usually the one space after ///. Such descriptions are indented three spaces after ///. -->
    <module name="RegexpMultiline">
        <property name="format"
                  value="^[ \t]*///[ \t]*@(return|(param|throws|exception)[ \t]+\S+)[ \t]*\r?\n[ \t]*/// {4}"/>
        <property name="message"
                  value="Indent a block tag description on the next line by three spaces after ///."/>
    </module>

    <module name="LineLength">
        <property name="max" value="100"/>
        <property name="ignorePattern" value="^(package|import) |https?://"/>
    </module>
</module>
